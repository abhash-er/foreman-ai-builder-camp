{% extends "base.html.jinja" %}

{% block contents %}
<div class="flex flex-col">
  <div class="flex flex-row flex-wrap items-center gap-x-4 gap-y-2 mb-4">
    <div>
      <h1 class="text-xl font-semibold text-slate-900 leading-tight">Provenance graph</h1>
      <p class="text-sm text-slate-500">{{ job_count }} jobs · {{ edge_count }} dependency edges</p>
    </div>
    <div class="ml-auto flex flex-row flex-wrap items-center gap-4">
      <div class="flex items-center gap-2">
        <label for="expFilter" class="text-xs font-medium text-slate-500">Experiment</label>
        <select id="expFilter" class="text-sm border border-slate-200 rounded-lg px-2.5 py-1 bg-white text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-200 focus:border-indigo-400"></select>
      </div>
      <div class="flex flex-row flex-wrap gap-2 text-xs text-slate-600">
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 rounded-full px-2.5 py-1"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#60a5fa"></span> entry</span>
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 rounded-full px-2.5 py-1"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#f59e0b"></span> compute</span>
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 rounded-full px-2.5 py-1"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#34d399"></span> report</span>
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 rounded-full px-2.5 py-1"><span class="inline-block w-2.5 h-2.5 rounded-full" style="background:#cbd5e1"></span> other</span>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div id="network" style="height: 72vh; background-color: #fcfdff;
         background-image: radial-gradient(#e2e8f0 1px, transparent 1px); background-size: 22px 22px;"></div>
  </div>
  <p class="text-xs text-slate-400 mt-2">Scroll to zoom · drag to pan · click a node to open the job · use the controls (bottom-left) to re-fit.</p>
</div>

<!-- foreman's base template loads Monaco's AMD loader (defines define.amd); a UMD bundle would
     register through it instead of creating window.vis. Neutralize define while vis-network loads. -->
<script>window.__amd_define = window.define; window.define = undefined;</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/vis-network/9.1.9/standalone/umd/vis-network.min.js"></script>
<script>
  window.define = window.__amd_define; try { delete window.__amd_define; } catch (e) {}
  (function () {
    const container = document.getElementById("network");
    if (typeof vis === "undefined" || !vis.Network) {
      container.innerHTML = '<div class="p-4 text-sm text-red-600">vis-network failed to load '
        + '(no internet for the CDN?). The graph needs it.</div>';
      return;
    }
    const rawNodes = {{ nodes | safe }};
    const edges = {{ edges | safe }};
    const groupColors = {
      entry:   { background: "#eff6ff", border: "#3b82f6" },
      compute: { background: "#fff7ed", border: "#f59e0b" },
      report:  { background: "#ecfdf5", border: "#10b981" },
      other:   { background: "#f8fafc", border: "#94a3b8" },
    };
    const nodes = rawNodes.map(function (n) {
      const c = groupColors[n.group] || groupColors.other;
      const leaf = String(n.label).split("/").pop();        // compact, uniform labels
      const short = String(n.id).slice(0, 8);
      return Object.assign({}, n, {
        label: "<b>" + leaf + "</b>" + (n.experiment ? "\n<code>" + n.experiment + "</code>" : ""),
        color: { background: c.background, border: c.border,
                 highlight: { background: c.background, border: "#0f172a" },
                 hover: { background: c.background, border: "#0f172a" } },
        shape: "box",
        font: { multi: "html", face: "Inter, sans-serif", size: 13, color: "#334155",
                bold: { color: "#0f172a", size: 14, face: "Inter, sans-serif" },
                mono: { face: "'JetBrains Mono', ui-monospace, monospace", size: 10, color: "#94a3b8" } },
        margin: 12,
        borderWidth: 1.5,
        shadow: { enabled: true, color: "rgba(15,23,42,0.12)", size: 10, x: 0, y: 4 },
        widthConstraint: { minimum: 128, maximum: 230 },
        heightConstraint: { minimum: 44 },
      });
    });

    const data = { nodes: new vis.DataSet(nodes), edges: new vis.DataSet(edges) };
    const options = {
      layout: { hierarchical: { enabled: true, direction: "LR", sortMethod: "directed",
                                shakeTowards: "roots", levelSeparation: 200, nodeSpacing: 100,
                                treeSpacing: 130, blockShifting: true, edgeMinimization: true,
                                parentCentralization: true } },
      edges: { arrows: { to: { enabled: true, scaleFactor: 0.65 } },
               smooth: { type: "cubicBezier", forceDirection: "horizontal", roundness: 0.55 },
               color: { color: "#cbd5e1", highlight: "#6366f1", hover: "#94a3b8" },
               width: 1.5, selectionWidth: 1, hoverWidth: 0 },
      nodes: { shapeProperties: { borderRadius: 12 } },
      physics: false,
      interaction: { hover: true, tooltipDelay: 120, navigationButtons: true, keyboard: false },
    };
    const network = new vis.Network(container, data, options);
    // auto-fit once the hierarchical layout is drawn, so the default view is centered + framed.
    function fitView(animate) { network.fit({ animation: !!animate, maxZoomLevel: 1.1 }); }
    network.once("afterDrawing", function () { fitView(false); });

    // Click a node -> open its job detail page.
    network.on("click", function (params) {
      if (params.nodes && params.nodes.length) {
        const node = data.nodes.get(params.nodes[0]);
        if (node && node.url) window.location = node.url;
      }
    });

    // ---- experiment filter: isolate one (disjoint) pipeline ----
    const sel = document.getElementById("expFilter");
    const experiments = Array.from(new Set(nodes.map(function (n) { return n.experiment; })
                                      .filter(Boolean))).sort();
    sel.innerHTML = '<option value="__all__">All experiments (' + experiments.length + ')</option>'
      + experiments.map(function (e) { return '<option value="' + e + '">' + e + '</option>'; }).join("");
    function applyFilter(val) {
      let ns = nodes, es = edges;
      if (val && val !== "__all__") {
        ns = nodes.filter(function (n) { return n.experiment === val; });
        const ids = new Set(ns.map(function (n) { return n.id; }));
        es = edges.filter(function (e) { return ids.has(e.from) && ids.has(e.to); });
      }
      data.nodes.clear(); data.nodes.add(ns);
      data.edges.clear(); data.edges.add(es);
      fitView(true);
    }
    sel.addEventListener("change", function (e) { applyFilter(e.target.value); });

    fitView(false);
  })();
</script>
{% endblock %}
